#include <stdio.h>

char input[100];
int i = 0;
int error = 0;

void S();
void L();

void S()
{
    if(input[i] == 'a')
    {
        i++;
    }
    else if(input[i] == '(')
    {
        i++;

        L();

        if(input[i] == ')')
            i++;
        else
            error = 1;
    }
    else
    {
        error = 1;
    }
}

void L()
{
    S();

    while(input[i] == ',')
    {
        i++;
        S();
    }
}

int main()
{
    printf("Enter string: ");
    scanf("%s", input);

    S();

    if(error == 0 && input[i] == '\0')
        printf("Valid String\n");
    else
        printf("Invalid String\n");

    return 0;
}
