variable.y


%{
#include <stdio.h>
int yylex();
void yyerror(const char *s);
%}

%token LETTER DIGIT

%%

variable : LETTER
         | LETTER chars
         ;

chars : LETTER chars
      | DIGIT chars
      | LETTER
      | DIGIT
      ;

%%

void yyerror(const char *s)
{
    printf("Invalid Variable\n");
}

int main()
{
    printf("Enter a variable: ");
    if(yyparse() == 0)
        printf("Valid Variable\n");
    return 0;
}

variable.l


%{
#include "y.tab.h"
%}

%%

[a-zA-Z]    { return LETTER; }
[0-9]       { return DIGIT; }
[ \t]       ;
\n          { return 0; }
.           { return yytext[0]; }

