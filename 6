6.Convert the BNF rules into YACC form and write code to generate an abstract syntax tree.

ast.y


%{
#include <stdio.h>
#include <stdlib.h>

struct node {
    char ch;
    struct node *left, *right;
};

struct node* create(char ch, struct node *l, struct node *r)
{
    struct node *n = malloc(sizeof(struct node));
    n->ch = ch;
    n->left = l;
    n->right = r;
    return n;
}

void print(struct node *n, int d)
{
    if(n == NULL) return;

    for(int i=0; i<d; i++)
        printf("  ");

    printf("%c\n", n->ch);

    print(n->left, d+1);
    print(n->right, d+1);
}

struct node *root;

int yylex();
void yyerror(char *s);
%}

%union {
    struct node *n;
}

%token ID
%type <n> E T F

%%

E : E '+' T { $$ = create('+', $1, $3); root = $$; }
  | T       { $$ = $1; }
  ;

T : T '*' F { $$ = create('*', $1, $3); }
  | F       { $$ = $1; }
  ;

F : '(' E ')' { $$ = $2; }
  | ID        { $$ = create('i', NULL, NULL); }
  ;

%%

void yyerror(char *s)
{
    printf("Invalid expression\n");
}

int main()
{
    printf("Enter expression: ");
    yyparse();

    printf("\nAbstract Syntax Tree:\n");
    print(root, 0);

    return 0;
}


