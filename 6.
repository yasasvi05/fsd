6.Convert the BNF rules into YACC form and write code to generate an abstract syntax tree.

ast.y

%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct node {
    char v[20];
    struct node *l, *r;
} Node;

Node *root;

Node *create(char *v, Node *l, Node *r) {
    Node *n = malloc(sizeof(Node));
    strcpy(n->v, v);
    n->l = l; n->r = r;
    return n;
}

int yylex(void);
void yyerror(const char *s);

void draw(Node *n, int d) {
    if (!n) return;
    for (int i = 0; i < d; i++) printf("  ");
    printf("%s\n", n->v);
    if (n->l || n->r) printf("  / \\\n");
    draw(n->l, d+1);
    draw(n->r, d+1);
}
%}

%union { Node *n; char *s; }
%token <s> ID
%type <n> E T F

%%
E : ID '=' E { $$ = root = create("=", create($1,0,0),$3); }
  | E '+' T  { $$ = root = create("+",$1,$3); }
  | T        { $$ = root = $1; }
  ;
T : T '' F  { $$ = create("",$1,$3); }
  | F        { $$ = $1; }
  ;
F : '(' E ')' { $$ = $2; }
  | ID        { $$ = create($1,0,0); }
  ;
%%

void yyerror(const char *s) { printf("Invalid expression\n"); }

int main() {
    printf("Enter expression: ");
    yyparse();
    draw(root,0);
    return 0;
}


