8.Write a YACC program to evaluate algebraic expressions.

algebra.y 


%{
#include <stdio.h>
#include <stdlib.h>

int yylex();
void yyerror(const char *s);
%}

%token NUMBER

%left '+' '-'
%left '*' '/'
%right '^'

%%

input : expr '\n'
        {
            printf("Result = %d\n", $1);
        }
      ;

expr : expr '+' expr
        { $$ = $1 + $3; }
     | expr '-' expr
        { $$ = $1 - $3; }
     | expr '*' expr
        { $$ = $1 * $3; }
     | expr '/' expr
        { $$ = $1 / $3; }
     | NUMBER
        { $$ = $1; }
     ;

%%

void yyerror(const char *s)
{
    printf("Invalid expression\n");
}

int main()
{
    printf("Enter an expression: ");
    yyparse();
    return 0;
}


algebra.l


%{
#include "y.tab.h"
#include <stdlib.h>
%}

%%

[0-9]+    { yylval = atoi(yytext); return NUMBER; }
[ \t]     ;
\n        return '\n';
.         return yytext[0];

%%

for yacc
yacc -d file_name.y
lex file_name.l
gcc y.tab.c lex.yy.c -o file_name
